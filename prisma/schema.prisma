datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Device {
  id                String             @id @default(uuid())
  assetTag          String             @unique
  serialHash        String
  organisation      String
  make              String
  model             String
  ageMonths         Int
  lifecycleStatus   String             @default("monitored") // monitored, flagged, under_repair, repurposed, recycled, quarantine
  currentRole       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  components        Component[]
  diagnosticReports DiagnosticReport[]
  decisionCases     DecisionCase[]
  passportEvents    PassportEvent[]
}

model Component {
  id                 String          @id @default(uuid())
  deviceId           String
  device             Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type               String          // battery, ssd, ram, display, motherboard, chassis
  model              String
  serialHash         String?
  isReplaceable      Boolean         @default(true)
  pairingRestriction Boolean         @default(false)
  healthPercent      Float           // 0 - 100
  currentStatus      String          @default("healthy") // healthy, declining, critical, failed, harvested
  specsJson          String?         // JSON of technical attributes
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  healthSamples      HealthSample[]
  repairQuotes       RepairQuote[]
  decisionCases      DecisionCase[]
  passportEvents     PassportEvent[]
}

model HealthSample {
  id          String    @id @default(uuid())
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  timestamp   DateTime  @default(now())
  metricName  String    // full_charge_capacity_wh, smart_wear_pct, cycle_count, temp_c
  metricValue Float
  source      String
  confidence  String    // high, medium, low
}

model DiagnosticReport {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  source      String   // windows_collector, manual_json_upload, csv_import
  rawPayload  String
  checksum    String
  receivedAt  DateTime @default(now())
}

model ManualPart {
  id               String  @id @default(uuid())
  deviceModel      String
  componentType    String
  compatiblePartNo String
  partDescription  String
  manualUrl        String
  estimatedPrice   Float
  isAvailable      Boolean @default(true)
  supplier         String
}

model RepairQuote {
  id              String    @id @default(uuid())
  componentId     String
  component       Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  labourCost      Float
  partCost        Float
  totalCost       Float
  vendorName      String
  turnaroundHours Int
  status          String    @default("simulated") // simulated, approved, dispatched, completed
  expiry          DateTime
  createdAt       DateTime  @default(now())
}

model ReuseOption {
  id            String @id @default(uuid())
  componentType String
  targetRole    String
  prerequisites String
  safetyNotes   String
  policyStatus  String @default("approved") // approved, restricted, prohibited
}

model DecisionCase {
  id              String    @id @default(uuid())
  deviceId        String
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  componentId     String?
  component       Component? @relation(fields: [componentId], references: [id])
  recommendedPath String    // repair, same_role_reuse, cross_purpose_reuse, recycle
  confidenceScore Float
  justification   String
  evidenceJson    String    // Serialized multi-tool dossier
  policyVersion   String    @default("2026.3.1")
  riskTier        String    // green, amber, red
  status          String    @default("proposed") // proposed, pending_approval, approved, rejected, executed, blocked
  createdAt       DateTime  @default(now())
  approval        Approval?
  outcome         Outcome?
}

model Approval {
  id               String       @id @default(uuid())
  caseId           String       @unique
  decisionCase     DecisionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestedAction  String
  riskTier         String
  requiredRole     String       // asset_manager, senior_technician, sustainability_lead
  approverIdentity String?
  decision         String       @default("pending") // pending, approved, rejected
  comments         String?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
}

model PassportEvent {
  id            String     @id @default(uuid())
  deviceId      String
  device        Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  componentId   String?
  component     Component? @relation(fields: [componentId], references: [id])
  eventCategory String     // identity, health, decision, control, custody, verification
  eventType     String
  actor         String
  description   String
  evidenceRefs  String?    // JSON metadata or file hashes
  eventHash     String
  prevHash      String?
  timestamp     DateTime   @default(now())
}

model Outcome {
  id                         String       @id @default(uuid())
  caseId                     String       @unique
  decisionCase               DecisionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actualResult               String       // successful_repair, failed_repair, redeployed_kiosk, harvested_spares, certified_recycled
  actualCost                 Float
  usefulLifeExtensionMonths  Int
  verifiedBy                 String
  notes                      String?
  recordedAt                 DateTime     @default(now())
}

model AutonomySetting {
  id                    String   @id @default("default")
  repairMode            String   @default("draft_and_assist") // advisory, draft_and_assist, auto_within_policy, full_autonomy
  repairAutoLimitUSD    Float    @default(50.0)
  sameRoleReuseMode     String   @default("auto_within_policy")
  crossPurposeReuseMode String   @default("draft_and_assist")
  recycleMode           String   @default("auto_within_policy")
  requireWipeProof      Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model AdminEscalation {
  id               String   @id @default(uuid())
  deviceId         String?
  assetTag         String?
  queryText        String
  symptomSummary   String
  telemetrySnippet String?
  status           String   @default("pending") // pending, resolved, dismissed
  urgency          String   @default("medium")  // low, medium, critical
  adminResponse    String?
  learnedRule      String?
  resolvedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TechnicianBooking {
  id              String   @id @default(uuid())
  deviceId        String
  assetTag        String
  serviceType     String   // Battery Replacement, Thermal Servicing, Logic Board Rework
  technicianName  String
  vendorName      String
  estimatedCost   Float
  scheduledDate   DateTime
  serviceStatus   String   @default("dispatched") // dispatched, in_progress, completed
  workOrderNotes  String?
  createdAt       DateTime @default(now())
}

model ScrapValuation {
  id                String   @id @default(uuid())
  deviceId          String
  assetTag          String
  estimatedValueUSD Float
  preciousMetalsG   Float?
  copperG           Float?
  recyclerPartner   String
  pickupStatus      String   @default("scheduled") // scheduled, in_transit, verified_recycled
  createdAt         DateTime @default(now())
}

model UserProfile {
  id             String   @id @default("user_default")
  fullName       String   @default("Sarah Chen")
  email          String   @default("sarah.chen@techcorp.io")
  phoneNumber    String   @default("+91 98765 43210")
  role           String   @default("Lead Asset Manager")
  addressLine    String   @default("Block C, Tech Park Boulevard")
  city           String   @default("Bangalore")
  state          String   @default("Karnataka")
  pinCode        String   @default("560103")
  gpsCoordinates String   @default("12.9716, 77.5946")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model OndcBooking {
  id                 String   @id @default(uuid())
  ondcOrderId        String   @unique
  deviceId           String
  assetTag           String
  serviceCategory    String   // PC_HARDWARE_DOORSTEP_REPAIR
  serviceDescription String
  timeSlot           String   // e.g. "Tomorrow 10:00 AM - 12:00 PM"
  providerName       String   // e.g. "QuickFix Tech Hub via ONDC BPP"
  providerId         String
  bapId              String   // e.g. "reusechain.ondc.bap.org"
  bppId              String   // e.g. "services.ondc.bpp.provider.net"
  customerName       String
  customerPhone      String
  doorstepAddress    String
  pinCode            String
  gpsCoordinates     String
  totalAmountUSD     Float
  orderStatus        String   @default("CONFIRMED") // SEARCH, SELECT, INIT, CONFIRMED, COMPLETED
  trackingUrl        String?
  passportHash       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MediaAsset {
  id               String                @id @default(uuid())
  deviceId         String?
  assetTag         String?
  mediaType        String                // photo, screenshot, diagnostic_dump, thermal_scan
  fileName         String
  mimeType         String                // image/png, image/jpeg, application/json, text/plain
  fileSizeBytes    Int
  storageUrl       String                // Base64 Data URL or persistent local URI
  checksumSha256   String
  ocrExtractedText String?               // Optical characters extracted from screen photo
  metadataJson     String?               // Resolution, camera/sensor details, dimensions
  createdAt        DateTime              @default(now())
  embeddings       DiagnosticEmbedding[]
}

model DiagnosticEmbedding {
  id              String      @id @default(uuid())
  mediaAssetId    String?
  mediaAsset      MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  deviceId        String?
  assetTag        String?
  sourceType      String      // screen_photo, symptom_query, diagnostic_telemetry, root_cause
  modelName       String      @default("text-embedding-3-small")
  vectorDimension Int         @default(1536)
  vectorJson      String      // Serialized float array of embeddings
  rawContent      String      // Text or signature from which embedding was generated
  createdAt       DateTime    @default(now())
}


